# 비밀 값(DB 비밀번호, API 인증키). 절대 올리지 않는다.
.env
# 원본 데이터 보관소. 용량이 크고 다시 받을 수 있으며, git이 관리할 대상이 아니다.
lake/
# 가상환경. 각자 PC에서 requirements.txt로 다시 만든다.
.venv/
# Python이 자동으로 만드는 캐시
__pycache__/
# Airflow 실패 알림 기록 (dags/alerting.py)
logs/
# 데이터 상품 출력물 (warehouse/export_product.py). 버전마다 다시 만들 수 있다.
product/
# dbt가 만드는 컴파일 결과 (warehouse/dbt). 실행할 때마다 다시 만든다.
target/
# dbt가 처음 실행할 때 만드는 익명 사용자 ID 파일
.user.yml
